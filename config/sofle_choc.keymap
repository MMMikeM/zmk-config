/*
 * Sofle Choc keymap - ported from the QMK sofle_choc:default keymap.
 *
 * Convention on the non-base layers: unmapped positions are &none, not &trans,
 * so a mispress while holding a layer produces nothing instead of injecting a
 * stray letter. The exceptions, which stay &trans deliberately:
 *
 *   - the whole thumb row (50-57), so Bspc/Enter/Space stay live while a layer
 *     is held, and so layer keys can still be chorded
 *   - Mute/Play (42, 43), wanted regardless of layer state
 *   - the modifiers: GUI (24) and both shifts (36, 49)
 *   - Tab (12)
 *
 * Position 11 is pointedly NOT transparent: it is &to QWE on the base layer,
 * and a stray press while holding a layer would silently swap the layout.
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define CMK 0
#define QWE 1
#define SYM 2
#define BKT 3
#define ARW 4

/ {
    behaviors {
        // Arrow layer is always a long deliberate hold (~1s), never a fast roll,
        // so the term only needs to clear a normal keytap. Shorter term = less
        // lag before the first arrow registers, since tap-preferred queues it
        // until the term expires. quick-tap-ms lets a doubled letter still type
        // through. Bound to both pinky bottom-row keys (Z and /) so either hand
        // can reach the layer while the thumbs stay free for Bspc/Enter.
        lt_arw: layer_tap_arrow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        // QMK BOTH_SHIFTS_TURNS_ON_CAPS_WORD: each shift morphs into caps word
        // when the other shift is already held. Unlike a combo there is no
        // timing window, and holding both shifts normally still works.
        caps_lsft: caps_lsft {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LSHFT>, <&caps_word>;
            mods = <(MOD_RSFT)>;
        };

        caps_rsft: caps_rsft {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RSHFT>, <&caps_word>;
            mods = <(MOD_LSFT)>;
        };

        // Encoder rotation -> mouse scroll (QMK KC_MS_WH_UP/DOWN).
        enc_scroll: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Esc used to sit in the top-left corner, which is a long reach for a
        // key pressed constantly. "fp" is not an English bigram, so this pair
        // cannot fire during normal typing; the short timeout covers fast
        // rolls anyway. Deliberately no require-prior-idle-ms: Esc
        // is usually pressed the instant typing stops, which is exactly what
        // that guard would block. Colemak only - the same positions are R and T
        // on qwerty, and that layer is for games, which keep Esc on its own key
        // and would misfire this constantly.
        combo_esc {
            timeout-ms = <40>;
            key-positions = <15 16>;
            bindings = <&kp ESC>;
            layers = <CMK>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak_dh {
            display-name = "colemak";
// Top row is unbound: the number row lives on SYM and Esc is the F+P combo.
// Only the layout switch is kept.
// .------------------------------------------.                    .------------------------------------------.
// |       |      |      |      |      |      |                    |      |      |      |      |      |TO(QRT)|
// | Tab   |   Q  |   W  |   F  |   P  |   B  |                    |   J  |   L  |   U  |   Y  |   ;  |   \   |
// | GUI   |   A  |   R  |   S  |   T  |   G  |                    |   M  |   N  |   E  |   I  |   O  |   '   |
// | Shift | Z/ARW|   X  |   C  |   D  |   V  |  Mute |    | Play  |   K  |   H  |   ,  |   .  | //ARW| Shift |
//                       | LCTL | LALT |  SPC |  SYM   |   |ENT    | Bspc |  BKT  | Del |
            bindings = <
&none     &none      &none    &none    &none    &none                             &none     &none    &none     &none   &none         &to QWE
&kp TAB   &kp Q      &kp W    &kp F    &kp P    &kp B                             &kp J     &kp L    &kp U     &kp Y   &kp SEMI      &kp BSLH
&kp LGUI  &kp A      &kp R    &kp S    &kp T    &kp G                             &kp M     &kp N    &kp E     &kp I   &kp O         &kp SQT
&caps_lsft &lt_arw ARW Z &kp X &kp C   &kp D    &kp V     &kp C_MUTE   &kp C_PP   &kp K     &kp H    &kp COMMA &kp DOT &lt_arw ARW FSLH &caps_rsft
                              &kp LCTRL &kp LALT &kp SPACE &mo SYM     &kp RET    &kp BSPC  &mo BKT  &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_scroll SCRL_DOWN SCRL_UP>;
        };

        qwerty {
            display-name = "qwerty";
// Gaming layer: plain keycodes only. No hold-taps, mod-morphs or combos, since
// games hold and mash keys in ways that trip every timing-based behavior. The
// number row and Esc stay put. Layer holds are kept because &mo has no timing.
            bindings = <
&kp ESC   &kp N1     &kp N2   &kp N3   &kp N4   &kp N5                            &kp N6    &kp N7   &kp N8    &kp N9  &kp N0        &to CMK
&kp TAB   &kp Q      &kp W    &kp E    &kp R    &kp T                             &kp Y     &kp U    &kp I     &kp O   &kp P         &kp BSLH
&kp LGUI  &kp A      &kp S    &kp D    &kp F    &kp G                             &kp H     &kp J    &kp K     &kp L   &kp SEMI      &kp SQT
&kp LSHFT &kp Z      &kp X    &kp C    &kp V    &kp B     &kp C_MUTE   &kp C_PP   &kp N     &kp M    &kp COMMA &kp DOT &kp FSLH      &kp RSHFT
                              &kp LCTRL &kp LALT &kp SPACE &mo SYM     &kp RET    &kp BSPC  &mo BKT  &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_scroll SCRL_DOWN SCRL_UP>;
        };

        symbols {
            display-name = "symbols";
// |       |      |      |      |      |      |                    |      |      |      |      |      |       |
// |       |  F1  |  F2  |  F3  |  F4  |  F5  |                    |  F6  |  F7  |  F8  |  F9  |  F10 |  F11  |
// |       |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |   0  |  F12  |
// |       |   !  |   @  |   #  |   $  |   %  |       |    |       |   ^  |   &  |   *  |   (  |   )  |       |
            bindings = <
&none      &none        &none        &none        &none        &none                       &none     &none    &none     &none    &none    &none
&trans     &kp F1       &kp F2       &kp F3       &kp F4       &kp F5                      &kp F6    &kp F7   &kp F8    &kp F9   &kp F10  &kp F11
&trans     &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                      &kp N6    &kp N7   &kp N8    &kp N9   &kp N0   &kp F12
&trans     &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT   &trans  &trans  &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &trans
                                     &trans       &trans       &trans      &trans  &trans  &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_scroll SCRL_DOWN SCRL_UP>;
        };

        brackets {
            display-name = "brackets";
// home row: [{(-_+=)}]`  (tilde omitted - shift+grave is easier than a detour)
            bindings = <
&none  &none    &none    &none    &none     &none                        &none    &none     &none    &none    &none    &none
&trans &none    &none    &none    &none     &none                        &none    &none     &none    &none    &none    &none
&trans &kp LBKT &kp LBRC &kp LPAR &kp MINUS &kp UNDER                    &kp PLUS &kp EQUAL &kp RPAR &kp RBRC &kp RBKT &kp GRAVE
&trans &none    &none    &none    &none     &none      &trans   &trans   &none    &none     &none    &none    &none    &trans
                         &trans   &trans    &trans     &trans   &trans   &trans   &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_scroll SCRL_DOWN SCRL_UP>;
        };

        arrows {
            display-name = "arrows";
// inverted-T on right hand, page/home/end on left. No &bootloader/&sys_reset
// keys: both halves have physical reset buttons, and reset behaviors run on
// the half where the key is pressed anyway, so soft keys add nothing.
//
// No &bt or &out keys: the dongle is permanently on USB, so it holds no host
// BLE bond for BT_CLR to clear and no second output for OUT_TOG to select -
// both would only ever fire by accident. Split pairing between the dongle and
// the halves is separate state, and the way to reset that is flashing the
// settings_reset firmware from build.yaml.
            bindings = <
&none       &none      &none  &none      &none     &none                     &none  &none    &none    &none     &none  &none
&trans      &none      &none  &kp PG_UP  &kp HOME  &none                     &none  &none    &kp UP   &none     &none  &none
&trans      &none      &none  &kp PG_DN  &kp END   &none                     &none  &kp LEFT &kp DOWN &kp RIGHT &none  &none
&trans      &none      &none  &none      &none     &none    &trans   &trans  &none  &none    &none    &none     &none  &trans
                              &trans     &trans    &trans   &trans   &trans  &trans &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_scroll SCRL_DOWN SCRL_UP>;
        };
    };
};
