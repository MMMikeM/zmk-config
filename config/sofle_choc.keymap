/*
 * Sofle Choc keymap - ported from the QMK sofle_choc:default keymap.
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define CMK 0
#define QWE 1
#define SYM 2
#define BKT 3
#define ARW 4

/ {
    behaviors {
        // QMK equivalent: TAPPING_TERM 300, FLOW_TAP_TERM 150.
        // require-prior-idle-ms is ZMK's flow-tap: a tap-hold pressed within
        // 150ms of another keypress resolves as a tap.
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // Encoder rotation -> mouse scroll (QMK KC_MS_WH_UP/DOWN).
        enc_scroll: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // QMK BOTH_SHIFTS_TURNS_ON_CAPS_WORD
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <36 49>;
            bindings = <&caps_word>;
            layers = <CMK QWE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak_dh {
            display-name = "colemak";
// .------------------------------------------.                    .------------------------------------------.
// | ESC   |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |   0  |TO(QRT)|
// | Tab   |   Q  |   W  |   F  |   P  |   B  |                    |   J  |   L  |   U  |   Y  |   ;  |   \   |
// | GUI   |   A  |   R  |   S  |   T  |   G  |                    |   M  |   N  |   E  |   I  | O/ARW|   '   |
// | Shift | Z/ARW|   X  |   C  |   D  |   V  |  Mute |    | Play  |   K  |   H  |   ,  |   .  |   /  | Shift |
//                       | LCTL | LALT |  SPC | SYM/ESC|   |ENT    | Bspc |BKT/TAB| Del |
            bindings = <
&kp ESC   &kp N1     &kp N2   &kp N3   &kp N4   &kp N5                            &kp N6    &kp N7   &kp N8    &kp N9  &kp N0        &to QWE
&kp TAB   &kp Q      &kp W    &kp F    &kp P    &kp B                             &kp J     &kp L    &kp U     &kp Y   &kp SEMI      &kp BSLH
&kp LGUI  &kp A      &kp R    &kp S    &kp T    &kp G                             &kp M     &kp N    &kp E     &kp I   &lt ARW O     &kp SQT
&kp LSHFT &lt ARW Z  &kp X    &kp C    &kp D    &kp V     &kp C_MUTE   &kp C_PP   &kp K     &kp H    &kp COMMA &kp DOT &kp FSLH      &kp RSHFT
                              &kp LCTRL &kp LALT &kp SPACE &lt SYM ESC  &kp RET   &kp BSPC  &lt BKT TAB &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_scroll SCRL_DOWN SCRL_UP>;
        };

        qwerty {
            display-name = "qwerty";
            bindings = <
&kp ESC   &kp N1     &kp N2   &kp N3   &kp N4   &kp N5                            &kp N6    &kp N7   &kp N8    &kp N9  &kp N0        &to CMK
&kp TAB   &kp Q      &kp W    &kp E    &kp R    &kp T                             &kp Y     &kp U    &kp I     &kp O   &kp P         &kp BSLH
&kp LGUI  &kp A      &kp S    &kp D    &kp F    &kp G                             &kp H     &kp J    &kp K     &kp L   &lt ARW SEMI  &kp SQT
&kp LSHFT &kp Z      &kp X    &kp C    &kp V    &kp B     &kp C_MUTE   &kp C_PP   &kp N     &kp M    &kp COMMA &kp DOT &kp FSLH      &kp RSHFT
                              &kp LCTRL &kp LALT &kp SPACE &lt SYM ESC  &kp RET   &kp BSPC  &lt BKT TAB &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_scroll SCRL_DOWN SCRL_UP>;
        };

        symbols {
            display-name = "symbols";
// Top row carries the wireless controls (no QMK equivalent).
// |BTCLR  | BT0  | BT1  | BT2  | BT3  |OUT_TG|                    |      |      |      |      |      |       |
// |       |  F1  |  F2  |  F3  |  F4  |  F5  |                    |  F6  |  F7  |  F8  |  F9  |  F10 |  F11  |
// |       |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |   0  |  F12  |
// |       |   !  |   @  |   #  |   $  |   %  |       |    |       |   ^  |   &  |   *  |   (  |   )  |       |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &out OUT_TOG                &trans    &trans   &trans    &trans   &trans   &trans
&trans     &kp F1       &kp F2       &kp F3       &kp F4       &kp F5                      &kp F6    &kp F7   &kp F8    &kp F9   &kp F10  &kp F11
&trans     &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                      &kp N6    &kp N7   &kp N8    &kp N9   &kp N0   &kp F12
&trans     &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT   &trans  &trans  &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &trans
                                     &trans       &trans       &trans      &trans  &trans  &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_scroll SCRL_DOWN SCRL_UP>;
        };

        brackets {
            display-name = "brackets";
// home row: [{(-_+=)}]`  top-right: ~
            bindings = <
&trans &trans   &trans   &trans   &trans    &trans                       &trans   &trans    &trans   &trans   &trans   &kp TILDE
&trans &trans   &trans   &trans   &trans    &trans                       &trans   &trans    &trans   &trans   &trans   &trans
&trans &kp LBKT &kp LBRC &kp LPAR &kp MINUS &kp UNDER                    &kp PLUS &kp EQUAL &kp RPAR &kp RBRC &kp RBKT &kp GRAVE
&trans &trans   &trans   &trans   &trans    &trans     &trans   &trans   &trans   &trans    &trans   &trans   &trans   &trans
                         &trans   &trans    &trans     &trans   &trans   &trans   &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_scroll SCRL_DOWN SCRL_UP>;
        };

        arrows {
            display-name = "arrows";
// inverted-T on right hand, page/home/end on left. Bootloader/reset on the
// two leftmost keys of the top row (no QMK equivalent, needed for wireless).
            bindings = <
&bootloader &sys_reset &trans &trans     &trans    &trans                    &trans &trans   &trans   &trans    &trans &trans
&trans      &trans     &trans &kp PG_UP  &kp HOME  &trans                    &trans &trans   &kp UP   &trans    &trans &trans
&trans      &trans     &trans &kp PG_DN  &kp END   &trans                    &trans &kp LEFT &kp DOWN &kp RIGHT &trans &trans
&trans      &trans     &trans &trans     &trans    &trans   &trans   &trans  &trans &trans   &trans   &trans    &trans &trans
                              &trans     &trans    &trans   &trans   &trans  &trans &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_scroll SCRL_DOWN SCRL_UP>;
        };
    };
};
