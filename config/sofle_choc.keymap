/*
 * Sofle Choc keymap - ported from the QMK sofle_choc:default keymap.
 *
 * Non-base layers use &none for unmapped positions so a mispress while
 * holding a layer sends nothing. Deliberate &trans exceptions: 
 * - Thumb cluster (50-57)
 * - Encoders: Mute/Play (42, 43)
 * - Outer columns: Ctrl (24), shifts (36, 49), Tab (12).
 * - Position 11 (Layout switch) is NOT &trans - a stray press while holding a layer would silently swap the layout.
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define CMK 0
#define QWE 1
#define SYM 2
#define BKT 3
#define ARW 4

/ {
    behaviors {
        // Arrow-layer hold, bound to both pinky home-row keys (A and O). Both
        // are high-frequency letters, so several guards keep a typed letter
        // from resolving as a layer hold:
        //
        // - balanced flavor: another key pressed *and released* while A/O is
        //   held means hold, so a quick "hold A, tap Down" engages without
        //   waiting for the tapping term. A roll (press A, press N, release
        //   A, release N) stays a tap. hold-preferred would turn word-initial
        //   "and"/"of" into arrows; tap-preferred always waits the full term.
        // - hold-trigger-key-positions gates the hold to the opposite hand's
        //   nav keys: releasing anything else first is a tap. This covers the
        //   word-initial case - the A in "around" taps because R is not a nav
        //   position. Cost: reaching a nav key on the same hand as the trigger
        //   (A -> Home/End/PgUp/PgDn, O -> arrows) means holding past the
        //   tapping term first instead of chording. hold-trigger-on-release
        //   defers that check to the first key release.
        // - require-prior-idle-ms forces an immediate tap when A/O is pressed
        //   within the window of the previous key. At 50 it only catches very
        //   fast rolls (~240wpm), trading mid-word protection for arrows being
        //   reachable almost straight after typing. At 150 the O in "around"
        //   was still resolving as a hold at slower speeds; raise it again if
        //   mid-word misfires come back.
        // - tapping-term-ms is the backstop: held past it with nothing else
        //   pressed, it is a hold. It is also the lag before a held arrow
        //   starts repeating and before same-hand nav works. Lower it if the
        //   layer feels slow; raise it if slow typing of A/O misfires.
        //
        // quick-tap-ms lets a doubled letter type through.
        lt_arw_l: layer_tap_arrow_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            require-prior-idle-ms = <50>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <20 31 32 33>;  // Up, Left, Down, Right
            hold-trigger-on-release;
        };

        lt_arw_r: layer_tap_arrow_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            require-prior-idle-ms = <50>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <15 16 27 28 29>;  // PgUp, Home, PgDn, End, PrtScn
            hold-trigger-on-release;
        };

        // QMK BOTH_SHIFTS_TURNS_ON_CAPS_WORD: each shift morphs into caps word
        // when the other shift is already held. No timing window, unlike a combo.
        caps_lsft: caps_lsft {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LSHFT>, <&caps_word>;
            mods = <(MOD_RSFT)>;
        };

        caps_rsft: caps_rsft {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RSHFT>, <&caps_word>;
            mods = <(MOD_LSFT)>;
        };

        // Encoder rotation -> mouse scroll (QMK KC_MS_WH_UP/DOWN).
        enc_scroll: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Esc on F+P: "fp" is not an English bigram, so this cannot fire during
        // normal typing. No require-prior-idle-ms - Esc is usually pressed the
        // instant typing stops, which that guard would block. Colemak only: the
        // same positions are R/T on qwerty, whose gaming use would misfire it.
        // The window is 40ms (vs the 50ms default) because F is deferred while
        // the combo is a live candidate - the window is the worst-case lag on
        // every f typed on this layer.
        combo_esc {
            timeout-ms = <40>;
            key-positions = <15 16>;
            bindings = <&kp ESC>;
            layers = <CMK>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak_dh {
            display-name = "colemak";
// Top row unbound: numbers live on SYM, Esc is the F+P combo; only the
// layout switch is kept.
// .-----.-----.-----.-----.-----.-----.               .-----.-----.-----.-----.-----.-----.
// |     |     |     |     |     |     |               |     |     |     |     |     | >QWE|
// :-----+-----+-----+-----+-----+-----:               :-----+-----+-----+-----+-----+-----:
// | Tab |  Q  |  W  |  F  |  P  |  B  |               |  J  |  L  |  U  |  Y  |  ;  |  \  |
// :-----+-----+-----+-----+-----+-----:               :-----+-----+-----+-----+-----+-----:
// | Ctrl|A/ARW|  R  |  S  |  T  |  G  |               |  M  |  N  |  E  |  I  |O/ARW|  '  |
// :-----+-----+-----+-----+-----+-----:-----.   .-----:-----+-----+-----+-----+-----+-----:
// |Shift|  Z  |  X  |  C  |  D  |  V  | Mute|   | Play|  K  |  H  |  ,  |  .  |  /  |Shift|
// '-----+-----+-----+-----+-----+-----+-----'   '-----+-----+-----+-----+-----+-----+-----'
//                   | GUI | Alt |Space| SYM |   | Ent | Bspc| BKT | Del |
//                   '-----'-----'-----'-----'   '-----'-----'-----'-----'
            bindings = <
&none     &none      &none    &none    &none    &none                             &none     &none    &none     &none   &none         &to QWE
&kp TAB   &kp Q      &kp W    &kp F    &kp P    &kp B                             &kp J     &kp L    &kp U     &kp Y   &kp SEMI      &kp BSLH
&kp LCTRL &lt_arw_l ARW A &kp R &kp S  &kp T    &kp G                             &kp M     &kp N    &kp E     &kp I   &lt_arw_r ARW O &kp SQT
&caps_lsft &kp Z     &kp X    &kp C    &kp D    &kp V     &kp C_MUTE   &kp C_PP   &kp K     &kp H    &kp COMMA &kp DOT &kp FSLH      &caps_rsft
                              &kp LGUI  &kp LALT &kp SPACE &mo SYM     &kp RET    &kp BSPC  &mo BKT  &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_scroll SCRL_DOWN SCRL_UP>;
        };

        qwerty {
            display-name = "qwerty";
// Gaming layer: plain keycodes only - games hold and mash keys in ways that
// trip every timing-based behavior. &mo layer holds are fine (no timing).
// .-----.-----.-----.-----.-----.-----.               .-----.-----.-----.-----.-----.-----.
// | Esc |  1  |  2  |  3  |  4  |  5  |               |  6  |  7  |  8  |  9  |  0  | >CMK|
// :-----+-----+-----+-----+-----+-----:               :-----+-----+-----+-----+-----+-----:
// | Tab |  Q  |  W  |  E  |  R  |  T  |               |  Y  |  U  |  I  |  O  |  P  |  \  |
// :-----+-----+-----+-----+-----+-----:               :-----+-----+-----+-----+-----+-----:
// | Ctrl|  A  |  S  |  D  |  F  |  G  |               |  H  |  J  |  K  |  L  |  ;  |  '  |
// :-----+-----+-----+-----+-----+-----:-----.   .-----:-----+-----+-----+-----+-----+-----:
// |Shift|  Z  |  X  |  C  |  V  |  B  | Mute|   | Play|  N  |  M  |  ,  |  .  |  /  |Shift|
// '-----+-----+-----+-----+-----+-----+-----'   '-----+-----+-----+-----+-----+-----+-----'
//                   | GUI | Alt |Space| SYM |   | Ent | Bspc| BKT | Del |
//                   '-----'-----'-----'-----'   '-----'-----'-----'-----'
            bindings = <
&kp ESC   &kp N1     &kp N2   &kp N3   &kp N4   &kp N5                            &kp N6    &kp N7   &kp N8    &kp N9  &kp N0        &to CMK
&kp TAB   &kp Q      &kp W    &kp E    &kp R    &kp T                             &kp Y     &kp U    &kp I     &kp O   &kp P         &kp BSLH
&kp LCTRL &kp A      &kp S    &kp D    &kp F    &kp G                             &kp H     &kp J    &kp K     &kp L   &kp SEMI      &kp SQT
&kp LSHFT &kp Z      &kp X    &kp C    &kp V    &kp B     &kp C_MUTE   &kp C_PP   &kp N     &kp M    &kp COMMA &kp DOT &kp FSLH      &kp RSHFT
                              &kp LGUI  &kp LALT &kp SPACE &mo SYM     &kp RET    &kp BSPC  &mo BKT  &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_scroll SCRL_DOWN SCRL_UP>;
        };

        symbols {
            display-name = "symbols";
// .-----.-----.-----.-----.-----.-----.               .-----.-----.-----.-----.-----.-----.
// |     |     |     |     |     |     |               |     |     |     |     |     |     |
// :-----+-----+-----+-----+-----+-----:               :-----+-----+-----+-----+-----+-----:
// |  ~  |  F1 |  F2 |  F3 |  F4 |  F5 |               |  F6 |  F7 |  F8 |  F9 | F10 | F11 |
// :-----+-----+-----+-----+-----+-----:               :-----+-----+-----+-----+-----+-----:
// |  ~  |  1  |  2  |  3  |  4  |  5  |               |  6  |  7  |  8  |  9  |  0  | F12 |
// :-----+-----+-----+-----+-----+-----:-----.   .-----:-----+-----+-----+-----+-----+-----:
// |  ~  |  !  |  @  |  #  |  $  |  %  |  ~  |   |  ~  |  ^  |  &  |  *  |  (  |  )  |  ~  |
// '-----+-----+-----+-----+-----+-----+-----'   '-----+-----+-----+-----+-----+-----+-----'
//                   |  ~  |  ~  |  ~  |  ~  |   |  ~  |  ~  |  ~  |  ~  |
//                   '-----'-----'-----'-----'   '-----'-----'-----'-----'
            bindings = <
&none      &none        &none        &none        &none        &none                       &none     &none    &none     &none    &none    &none
&trans     &kp F1       &kp F2       &kp F3       &kp F4       &kp F5                      &kp F6    &kp F7   &kp F8    &kp F9   &kp F10  &kp F11
&trans     &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                      &kp N6    &kp N7   &kp N8    &kp N9   &kp N0   &kp F12
&trans     &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT   &trans  &trans  &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &trans
                                     &trans       &trans       &trans      &trans  &trans  &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_scroll SCRL_DOWN SCRL_UP>;
        };

        brackets {
            display-name = "brackets";
// home row: [{(-_+=)}]`  (tilde omitted - shift+grave is easier than a detour)
// .-----.-----.-----.-----.-----.-----.               .-----.-----.-----.-----.-----.-----.
// |     |     |     |     |     |     |               |     |     |     |     |     |     |
// :-----+-----+-----+-----+-----+-----:               :-----+-----+-----+-----+-----+-----:
// |  ~  |     |     |     |     |     |               |     |     |     |     |     |  ~  |
// :-----+-----+-----+-----+-----+-----:               :-----+-----+-----+-----+-----+-----:
// |  ~  |  [  |  {  |  (  |  -  |  _  |               |  +  |  =  |  )  |  }  |  ]  |  `  |
// :-----+-----+-----+-----+-----+-----:-----.   .-----:-----+-----+-----+-----+-----+-----:
// |  ~  |     |     |     |     |     |  ~  |   |  ~  |     |     |     |     |     |  ~  |
// '-----+-----+-----+-----+-----+-----+-----'   '-----+-----+-----+-----+-----+-----+-----'
//                   |  ~  |  ~  |  ~  |  ~  |   |  ~  |  ~  |  ~  |  ~  |
//                   '-----'-----'-----'-----'   '-----'-----'-----'-----'
            bindings = <
&none  &none    &none    &none    &none     &none                        &none    &none     &none    &none    &none    &none
&trans &none    &none    &none    &none     &none                        &none    &none     &none    &none    &none    &trans
&trans &kp LBKT &kp LBRC &kp LPAR &kp MINUS &kp UNDER                    &kp PLUS &kp EQUAL &kp RPAR &kp RBRC &kp RBKT &kp GRAVE
&trans &none    &none    &none    &none     &none      &trans   &trans   &none    &none     &none    &none    &none    &trans
                         &trans   &trans    &trans     &trans   &trans   &trans   &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_scroll SCRL_DOWN SCRL_UP>;
        };

        arrows {
            display-name = "arrows";
// inverted-T on right hand, page/home/end on left. No reset keys (both halves
// have physical reset buttons) and no &bt/&out keys (the USB-only dongle has
// no host bond to clear or output to toggle; split pairing is reset by
// flashing settings_reset from build.yaml).
// .-----.-----.-----.-----.-----.-----.               .-----.-----.-----.-----.-----.-----.
// |     |     |     |     |     |     |               |     |     |     |     |     |     |
// :-----+-----+-----+-----+-----+-----:               :-----+-----+-----+-----+-----+-----:
// |  ~  |     |     | PgUp| Home|     |               |     |     |  Up |     |     |  ~  |
// :-----+-----+-----+-----+-----+-----:               :-----+-----+-----+-----+-----+-----:
// |  ~  |     |     | PgDn| End | PrSc|               |     | Left| Down| Rght|     |  ~  |
// :-----+-----+-----+-----+-----+-----:-----.   .-----:-----+-----+-----+-----+-----+-----:
// |  ~  |     |     |     |     |     |  ~  |   |  ~  |     |     |     |     |     |  ~  |
// '-----+-----+-----+-----+-----+-----+-----'   '-----+-----+-----+-----+-----+-----+-----'
//                   |  ~  |  ~  |  ~  |  ~  |   |  ~  |  ~  |  ~  |  ~  |
//                   '-----'-----'-----'-----'   '-----'-----'-----'-----'
            bindings = <
&none       &none      &none  &none      &none     &none                     &none  &none    &none    &none     &none  &none
&trans      &none      &none  &kp PG_UP  &kp HOME  &none                     &none  &none    &kp UP   &none     &none  &trans
&trans      &none      &none  &kp PG_DN  &kp END   &kp PSCRN                     &none  &kp LEFT &kp DOWN &kp RIGHT &none  &trans
&trans      &none      &none  &none      &none     &none &trans  &trans  &none  &none    &none    &none     &none  &trans
                              &trans     &trans    &trans   &trans   &trans  &trans &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_scroll SCRL_DOWN SCRL_UP>;
        };
    };
};
