# SPDX-License-Identifier: MIT

if SHIELD_SOFLE_CHOC_LEFT || SHIELD_SOFLE_CHOC_RIGHT || SHIELD_SOFLE_CHOC_DONGLE

config ZMK_KEYBOARD_NAME
    default "Sofle Choc"

config ZMK_SPLIT
    default y

endif

# Both halves are peripherals and the dongle is the central, so nothing to set
# for the halves: ZMK_SPLIT_ROLE_CENTRAL already defaults to n, and EC11 enables
# itself via `depends on DT_HAS_ALPS_EC11_ENABLED` when an encoder node is okay.

if SHIELD_SOFLE_CHOC_DONGLE

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

config BT_MAX_CONN
    default 6

config BT_MAX_PAIRED
    default 6

endif
